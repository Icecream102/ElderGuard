# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP email (optional)
ELDERGUARD_SMTP_HOST=smtp.example.com
ELDERGUARD_SMTP_PORT=465
ELDERGUARD_SMTP_USER=
ELDERGUARD_SMTP_PASSWORD=
ELDERGUARD_SMTP_FROM=

# Directory for saved alert frames
ELDERGUARD_ALERT_OUTPUT=abnormal_pic
