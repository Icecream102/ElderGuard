# Inference
ELDERGUARD_SOURCE=0
ELDERGUARD_DEVICE=cuda
ELDERGUARD_ACTION_MODEL=Models/TSSTG/tsstg-model.pth

# MySQL (needed only for the alert service)
ELDERGUARD_DB_HOST=localhost
ELDERGUARD_DB_USER=elderguard
ELDERGUARD_DB_PASSWORD=change-me
